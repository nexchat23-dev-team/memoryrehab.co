rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Store settings (announcements, free shipping threshold, promos, themes, maintenance, footer)
    match /store_settings/{document} {
      allow read, write: if true;
    }

    // 2. Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // 3. Customer reviews
    match /reviews/{productId}/entries/{reviewId} {
      allow read, write: if true;
    }

    // 4. User wishlists (cross-device routine sync)
    match /user_wishlists/{userEmail} {
      allow read, write: if true;
    }

    // 5. User profiles, routine tenure, achievement streaks & badges
    match /users/{userId} {
      allow read, write: if true;
    }
    match /user_profiles/{userEmail} {
      allow read, write: if true;
    }

    // 6. Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 7. Fallback catch-all for any other store documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
